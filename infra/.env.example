# Copie para .env (ou rode ./gerar-env.sh, que já cria as senhas).
# NUNCA suba o .env para o GitHub.

# ---------- Banco e fila ----------
POSTGRES_PASSWORD=troque
REDIS_PASSWORD=troque

# ---------- Chatwoot ----------
SECRET_KEY_BASE=troque
# Endereço público do Chatwoot (o domínio do túnel no computador, ou o domínio da VPS)
FRONTEND_URL=https://seu-dominio.ngrok-free.app
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
FORCE_SSL=false
RAILS_ENV=production
INSTALLATION_ENV=docker
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
ACTIVE_STORAGE_SERVICE=local
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot
REDIS_URL=redis://redis:6379

# ---------- n8n ----------
N8N_ENCRYPTION_KEY=troque
# No computador: localhost e http. Na VPS: o domínio do n8n e https.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# ---------- Atendimento Malúvia ----------
MALUVIA_MODELO_IA=claude-haiku-5-5
MALUVIA_EMAIL_REMETENTE=atendimento@exemplo.com
MALUVIA_EMAIL_EQUIPE=equipe@exemplo.com
MALUVIA_CHAVE_RELATORIO=troque

# ---------- Túnel (só no computador) ----------
# Conta grátis em ngrok.com: copie o authtoken e crie o domínio estático grátis
NGROK_AUTHTOKEN=
NGROK_DOMAIN=seu-dominio.ngrok-free.app

# ---------- Produção (só na VPS) ----------
# Subdomínios apontados para o IP da VPS
CHATWOOT_DOMAIN=chat.seudominio.com.br
N8N_DOMAIN=n8n.seudominio.com.br
